# Export these in the shell or service manager before starting Python.
ALAS_TTS_HOST=127.0.0.1
ALAS_TTS_PORT=8000
ALAS_TTS_CACHE_DIR=.tts-cache
ALAS_TTS_CACHE_MB=128
ALAS_TTS_CACHE_DAYS=30
ALAS_TTS_CONCURRENCY=3
ALAS_TTS_PENDING=20
ALAS_TTS_RATE_LIMIT=60
ALAS_TTS_ATTEMPT_TIMEOUT=10
ALAS_TTS_REQUEST_TIMEOUT=26
ALAS_TTS_PASSAGE_TIMEOUT=240
ALAS_TTS_RETRIES=1
ALAS_TTS_RETRY_BACKOFF_MS=350

# Set this in the Vite shell if the API runs at a different address.
ALAS_TTS_PROXY_TARGET=http://127.0.0.1:8000
